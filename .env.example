# =============================================================================
# Kampas - University of Eastern Africa, Baraton (UEAB) Student Platform
# Environment Configuration Template
# =============================================================================

# Clerk Authentication (Get your publishable key at https://dashboard.clerk.com)
# When left unset or using demo placeholder, Kampas activates the built-in
# interactive dev role switcher and demo session provider so all 6 flows run seamlessly.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample_clerk_key_ueab_baraton"

# Supabase (Get your project credentials at https://supabase.com/dashboard)
# When set, Kampas uses your live Supabase instance with Clerk JWT integration.
# When unset or in demo mode, Kampas automatically falls back to an in-memory
# reactive Supabase simulation seeded with complete UEAB academic data.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Dev Role Switcher Flag (true | false)
# Enables switching between Student, Lecturer, Class Rep, Club Officer, Alumnus, Employer, Staff, Admin
VITE_DEV_ROLE_SWITCHER="true"

# Optional App URL for production deployment / OAuth redirects
APP_URL="https://ais-dev-rxhbbpehvjbngvmloctkss-53743166368.europe-west2.run.app"
